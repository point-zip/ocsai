# ============ AI（OpenAI Responses 协议）============
OCS_API_KEY=sk-xxxxxxxxxxxxxxxx
OCS_BASE_URL=https://api.openai.com/v1
OCS_MODEL=gpt-4.1-mini
OCS_REASONING_EFFORT=low
OCS_AI_TIMEOUT=45
OCS_USE_JSON_SCHEMA=true

# ============ 服务 ============
# 默认只监听回环。要让别的机器访问，先设 OCS_API_TOKEN，再改这里。
OCS_HOST=127.0.0.1
OCS_PORT=6767
OCS_API_TOKEN=

# ============ 答题策略 ============
# 低于该置信度的题直接返回 ok:false，宁可不填也不填错
OCS_MIN_CONFIDENCE=0.55
# 单题最多几张图、单张最大多少 KB，超限整体拒绝
OCS_MAX_IMAGES=6
OCS_MAX_IMAGE_KB=4096

# ============ 缓存 ============
OCS_CACHE_ENABLED=true
OCS_CACHE_PATH=cache.sqlite3
OCS_CACHE_TTL_DAYS=30
OCS_CACHE_MAX_ROWS=50000
